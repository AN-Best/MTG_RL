    <!-- Ground Plane at z = 0 -->
    <geom name="floor" type="plane" pos="0 0 0" size="100 100 0.1" material="grid_mat"/>

    <!-- ================================================================= -->
    <!-- ROBOT 1: FADED GHOST (Mode 1: Ideal Unlimited PD Baseline)        -->
    <!-- Semi-transparent cyan/blue ghost, no physics collisions (contype=0)-->
    <!-- ================================================================= -->
    <body name="pelvis_g" pos="0 0 0">
      <joint name="root_x_g" type="slide" axis="1 0 0" damping="0" armature="0"/>
