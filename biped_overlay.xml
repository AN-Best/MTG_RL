  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.92 0.95 1.0" rgb2="0.65 0.75 0.88" width="512" height="512"/>
    <texture name="grid" type="2d" builtin="checker" width="512" height="512" rgb1="0.95 0.95 0.95" rgb2="0.82 0.82 0.82"/>
